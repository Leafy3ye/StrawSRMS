{
  "name": "StrawSRMS",
  "private": true,
  "version": "0.0.4",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron ./src/electron-main.js",
    "electron-pack": "npm run build && electron-builder"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.9.1",
    "express": "^4.18.2",
    "gsap": "^3.13.0",
    "pinia": "^2.3.0",
    "pinyin": "^4.0.0",
    "pinyin-pro": "^3.26.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^36.1.0",
    "electron-builder": "^23.6.0",
    "terser": "^5.43.1",
    "vite": "^6.0.1",
    "vite-plugin-compression": "^0.5.1"
  },
  "build": {
    "appId": "com.coffee.app",
    "productName": "Coffee Management System",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "src/electron-main.js",
      "package.json",
      "node_modules/express/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ]
  },
  "main": "src/electron-main.js"
}
